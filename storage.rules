rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // -------------------------------------------------------------------------
    // COMPANY-SCOPED STORAGE (Product images, invoice PDFs, reports)
    // -------------------------------------------------------------------------
    match /companies/{companyId}/{allPaths=**} {
      // Allow read and write only for authenticated company owners
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // DENY ROOT AND UNMANAGED FILE ACCESS
    // -------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
